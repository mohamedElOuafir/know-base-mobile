<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collection_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".view.activity.CollectionPage">

    <!-- Header section -->
    <LinearLayout
        android:id="@+id/collectionPageHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Workspace label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WORKSPACE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/blue"
            android:layout_marginBottom="4dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My collections"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <!-- Count subtitle -->
        <TextView
            android:id="@+id/tvCollectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 collections"
            android:textSize="13sp"
            android:textColor="@color/grey"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Search bar + New button row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Search field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchCollectionInput"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeWidth="0.5dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintTextColor="@color/blue"
                app:cursorColor="@color/blue"
                app:boxStrokeColor="@color/blue"
                app:boxBackgroundColor="#F5F8FD"
                app:endIconDrawable="@drawable/ic_search"
                app:endIconTint="@color/grey"
                app:endIconMode="custom"
                >

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search collections…"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey"
                    android:inputType="text"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- New collection button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/NewCollectionButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="New"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"

                app:iconTint="@color/white"
                app:iconSize="14dp"
                app:iconPadding="6dp"
                app:backgroundTint="@color/blue"
                app:cornerRadius="10dp"
                app:elevation="0dp" />

        </LinearLayout>

        <!-- Filter tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue"
                    android:paddingStart="0dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Divider below tabs -->
    <View
        android:id="@+id/recyclerHeaderCollectionDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="#EEF2F8"
        app:layout_constraintTop_toBottomOf="@id/collectionPageHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/recyclerHeaderCollectionDivider"
        app:layout_constraintBottom_toTopOf="@id/navBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_folder_open"
            android:alpha="0.25"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No collections yet"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to create your first collection"
            android:textSize="13sp"
            android:textColor="@color/grey"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyStateNewButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="New collection"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/blue"
            app:cornerRadius="10dp"
            app:elevation="0dp" />

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCollections"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:background="#e8f4ff"
        app:layout_constraintTop_toBottomOf="@id/recyclerHeaderCollectionDivider"
        app:layout_constraintBottom_toTopOf="@id/navBarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- Navigation bar -->
    <LinearLayout
        android:id="@+id/navBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include layout="@layout/nav_bar" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>