<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_profile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1B2A"
    tools:context=".view.activity.ProfileActivity">

    <!-- Hero gradient background header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_profile_hero" />

    <!-- Decorative circle accent top-right -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-40dp"
        android:background="@drawable/bg_circle_accent"
        android:alpha="0.18" />

    <!-- Decorative circle accent bottom-left -->
    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="160dp"
        android:layout_marginStart="-30dp"
        android:background="@drawable/bg_circle_accent"
        android:alpha="0.10" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Bar -->
            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="52dp"
                android:paddingBottom="16dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="Back"
                    android:src="@drawable/arrow_left_icon"
                    android:padding="10dp"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="My Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />


            </LinearLayout>

            <!-- Avatar + Name block -->

            <!-- Main form card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="48dp">

                <!-- Avatar ring + FAB -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="136dp"
                    android:layout_height="136dp">

                    <!-- Outer glow ring -->
                    <View
                        android:layout_width="136dp"
                        android:layout_height="136dp"
                        android:background="@drawable/bg_avatar_ring"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/imageProfile"
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_avatar_image"
                        android:contentDescription="Profile Picture"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#90CAF9" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fab_edit_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:contentDescription="Edit Photo"
                        android:src="@drawable/edit"
                        app:backgroundTint="#1565C0"
                        app:elevation="8dp"
                        app:fabSize="mini"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:tint="#FFFFFF" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Name & subtitle hint -->
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.02"
                    android:text="Your Name"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUserEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="yourname@email.com"
                    android:textColor="#90CAF9"
                    android:textSize="14sp" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:cardCornerRadius="36dp"
                app:cardElevation="24dp"
                app:cardBackgroundColor="#F0F4FF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="36dp">

                    <!-- Section Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL INFO"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="20dp" />

                    <!-- First Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First Name"
                        android:textColor="#455A64"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_input_modern"
                        android:hint="Enter first name"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#0D1B2A"
                        android:textColorHint="#B0BEC5"
                        android:textSize="15sp"
                        android:inputType="textPersonName" />

                    <!-- Last Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Last Name"
                        android:textColor="#455A64"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/editLastName"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginBottom="28dp"
                        android:background="@drawable/bg_input_modern"
                        android:hint="Enter last name"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#0D1B2A"
                        android:textColorHint="#B0BEC5"
                        android:textSize="15sp"
                        android:inputType="textPersonName" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E3EAF5"
                        android:layout_marginBottom="28dp" />

                    <!-- Section Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCOUNT DETAILS"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:layout_marginBottom="20dp" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Password"
                        android:textColor="#455A64"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="#1976D2"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editNewPassword"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_input_modern"
                                android:hint="New Password"
                                android:paddingStart="20dp"
                                android:paddingEnd="52dp"
                                android:textColor="#0D1B2A"
                                android:textColorHint="#B0BEC5"
                                android:textSize="15sp"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirm New Password"
                        android:textColor="#455A64"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#1976D2"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editConfirmNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_input_modern"
                            android:hint="Confirm new Password"
                            android:paddingStart="20dp"
                            android:paddingEnd="52dp"
                            android:textColor="#0D1B2A"
                            android:textColorHint="#B0BEC5"
                            android:textSize="15sp"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Update Profile Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveProfile"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:layout_marginBottom="14dp"
                        android:text="Update Profile"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06"
                        app:backgroundTint="#1565C0"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/edit"
                        app:iconTint="#FFFFFF"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:elevation="6dp"
                        style="@style/Widget.MaterialComponents.Button" />

                    <!-- Log Out Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Log Out"
                        android:textColor="#E53935"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        app:strokeColor="#FFCDD2"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="16dp"
                        app:backgroundTint="#FFF5F5"
                        app:icon="@android:drawable/ic_lock_power_off"
                        app:iconTint="#E53935"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>