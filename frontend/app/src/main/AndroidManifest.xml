<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/kb_logo_blue"
        android:label="@string/app_name"
        android:roundIcon="@drawable/kb_logo_blue"
        android:supportsRtl="true"
        android:theme="@style/Theme.KnowBase">
        <activity
            android:name=".view.activity.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".view.activity.ProfileActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.activity.ChatbotActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".view.activity.ConsultCollection"
            android:exported="false" />
        <activity
            android:name=".view.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.activity.Signup"
            android:exported="false" />
        <activity
            android:name=".view.activity.Login"
            android:exported="false" />
        <activity
            android:name=".view.activity.CollectionPage"
            android:exported="false"
            />
    </application>

</manifest>